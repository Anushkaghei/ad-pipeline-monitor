# ============================================================
# Ad Pipeline Monitor — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All values below are defaults for local Docker development.

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ad_pipeline
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=pipeline_pass

# ── Meta Ads API (optional — mock adapter used if blank) ─────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# ── Google Ads API (optional — mock adapter used if blank) ───
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ── Alerting — Slack (optional) ──────────────────────────────
SLACK_WEBHOOK_URL=

# ── Alerting — Email / SMTP (optional) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=team@example.com

# ── AWS (optional — for Lambda deployment) ───────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Monitoring Thresholds ────────────────────────────────────
ROW_COUNT_DEVIATION_THRESHOLD=0.30
NULL_THRESHOLD_PERCENT=5.0
FRESHNESS_SLA_HOURS=6
ANOMALY_LOOKBACK_DAYS=7

# ── FastAPI ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
